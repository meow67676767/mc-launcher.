<?xml version="1.0" encoding="utf-8"?>
<!-- Other ways to create a profile: modpacks and special runtimes -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_panel"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        style="@style/Glass.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:text="@string/create_profile_more" />

    <TextView
        android:id="@+id/modded_profile_modpack"
        style="@style/Glass.Row.Wrap"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/glass_gap"
        android:drawableStart="@drawable/ic_gl_modpack"
        android:text="@string/modpack_install_button" />

    <TextView
        android:id="@+id/modded_profile_lwjgl3ify"
        style="@style/Glass.Row.Wrap"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/glass_gap"
        android:drawableStart="@drawable/ic_gl_sparkle"
        android:text="@string/create_lwjgl3ify_profile" />

    <TextView
        android:id="@+id/modded_profile_bta"
        style="@style/Glass.Row.Wrap"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/glass_gap"
        android:drawableStart="@drawable/ic_gl_sparkle"
        android:text="@string/create_bta_profile" />
</LinearLayout>
