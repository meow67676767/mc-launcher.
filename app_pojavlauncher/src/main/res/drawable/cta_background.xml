<?xml version="1.0" encoding="utf-8"?>
<!-- Orange call-to-action button: gradient when enabled, plain glass when disabled -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/glass_radius" />
            <solid android:color="@color/glass_fill_strong" />
            <stroke
                android:width="@dimen/glass_stroke_width"
                android:color="@color/glass_stroke" />
        </shape>
    </item>
    <item>
        <ripple android:color="@color/glass_ripple">
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/glass_radius" />
                    <gradient
                        android:angle="315"
                        android:startColor="@color/cta_start"
                        android:endColor="@color/cta_end" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
