<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/glass_ripple">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/glass_radius_row" />
            <solid android:color="@color/glass_fill" />
            <stroke
                android:width="@dimen/glass_stroke_width"
                android:color="@color/glass_stroke" />
        </shape>
    </item>
</ripple>
